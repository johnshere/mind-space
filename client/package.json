{
  "name": "mind-space",
  "version": "0.0.0",
  "private": true,
  "description": "3D Mind Map",
  "type": "module",
  "scripts": {
    "--prepare": "cd .. && husky client/.husky",
    "build": "tsc && vite build",
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue}\"",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint . --ext .ts,.tsx,.vue --fix",
    "pre-commit": "pnpm run lint-staged",
    "preview": "vite preview",
    "test": "pnpm jest",
    "test:watch": "pnpm jest --watch"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "npm run lint"
    ]
  },
  "dependencies": {
    "axios": "^1.9.0",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/jest": "^29.5.14",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.14",
    "@types/nprogress": "^0.2.3",
    "@types/pouchdb": "^6.4.2",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "@vue/eslint-config-typescript": "^14.5.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-vue": "^10.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "only-allow": "^1.2.1",
    "pouchdb": "^9.0.0",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.87.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "unplugin-auto-import": "^19.2.0",
    "vite": "^6.3.5",
    "vite-plugin-environment": "^1.1.3",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-vue-devtools": "^7.7.6",
    "vue-eslint-parser": "^10.1.3"
  }
}